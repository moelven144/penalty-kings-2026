{
  "name": "penalty-world-cup-2026",
  "version": "3.0.0",
  "private": true,
  "description": "Penalty Kings: Shootout v3: 3D swipe penalty shootout (web + iOS via Capacitor)",
  "scripts": {
    "serve": "python3 -m http.server 8000 --directory www",
    "sync": "cap sync",
    "ios": "cap open ios",
    "icons": "capacitor-assets generate --ios",
    "serve:v2": "python3 -m http.server 8000",
    "test:v2": "node --test legacy/v2/test/*.test.mjs",
    "test:v3": "node --test v3/test/*.test.mjs",
    "serve:v3": "node scripts/dev-server.mjs 8000"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
